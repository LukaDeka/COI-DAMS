# Copy to .env and adjust the values as needed.
# Values here are the defaults


# Publications older than this year are discarded
COI_OLDEST_CUTOFF_YEAR=2016

# Papers with more co-authors than this are skipped. Huge author lists are
# consortium papers, where co-authorship means little
COI_MAX_COAUTHORS_PER_PAPER=50


# A pair's score is the weight of its shortest depth times the number of
# shortest paths. At depth 1 that counts the papers they co-authored, at deeper
# depths the distinct chains of people (the papers along a chain are ignored)
COI_WEIGHT_DEPTH_1=100
COI_WEIGHT_DEPTH_2=20
COI_WEIGHT_DEPTH_3=5
COI_WEIGHT_DEPTH_4=2

# Pairs scoring below this are omitted from the main output CSV, so
# treated as non-conflicts. The comparison is inclusive
COI_ACCEPT_THRESHOLD=5


# Minimum number of COI_QUALIFYING_VENUES papers for a reviewer to count as
# qualified by the "qualify" command.
COI_REVIEWER_MIN_PAPERS=2

# Venues that count towards COI_REVIEWER_MIN_PAPERS.
# Format:
# VENUE: keyword, keyword, keyword
# Where the keywords are substrings identifying that venue in a DBLP journal/booktitle
COI_QUALIFYING_VENUES="
  SIGMOD: sigmod, management of data
  VLDB: vldb, very large data bases, pvldb, proc. vldb
  ICDE: icde, data engineering
  EDBT: edbt, extending database technology
  CIDR: cidr, innovative data systems research
"


# Column separator of the input Users.csv.
# Tab is the default
# COI_USERS_CSV_DELIMITER=,


# Records buffered before each Parquet write while streaming
COI_CHUNK_SIZE=10000

# Worker processes used to parse the Semantic Scholar dumps in parallel
COI_S2_PARSE_WORKERS=4
